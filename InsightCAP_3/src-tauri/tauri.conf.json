{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InsightCAP",
  "version": "0.1.0",
  "identifier": "com.insightcap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "InsightCAP",
        "width": 1000,
        "height": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      },
      {
        "label": "quick-capture",
        "title": "Quick Capture",
        "width": 700,
        "height": 80,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  }
}