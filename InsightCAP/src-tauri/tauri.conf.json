{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InsightCAP",
  "version": "0.9.0-beta.3",
  "identifier": "com.insightcap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "InsightCAP",
        "width": 1580,
        "height": 1000,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      },
      {
        "label": "quick-capture",
        "title": "Quick Capture",
        "width": 700,
        "height": 80,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "yt-dlp.exe",
      "ffmpeg.exe",
      "pdfium.dll",
      "resources/*.dll",
      "resources/whisper-cli.exe",
      "resources/main.exe",
      "resources/vc-runtime/*",
      "resources/vc_redist.x64.exe"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer-template.nsi",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English",
          "TradChinese"
        ],
        "installerHooks": "installer.nsh"
      }
    }
  }
}
